{
  "opencollection": "1.0.0",
  "info": {
    "name": "MapTiler Coordinates Weather API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Weather",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Weather catalog",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.maptiler.com/weather/latest.json"
          },
          "docs": "List current weather-related variables, their metadata and individual keyframes"
        }
      ]
    }
  ],
  "bundled": true
}